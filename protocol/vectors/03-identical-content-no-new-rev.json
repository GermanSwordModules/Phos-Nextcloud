 "now": 1791200000000,
 "steps": [
  {
   "push": {
    "device": "aaaaaaaaaaaaaaaa",
    "changes": [
     {
      "changeId": "c001",
      "type": "label",
      "key": "label:Studium",
      "op": "upsert",
      "hlc": "1791200000000-0000-aaaaaaaaaaaaaaaa",
      "baseRev": 0,
      "payload": {
       "name": "Studium",
       "color": -16776961
      }
     }
    ]
   },
   "expect": [
