      ],
      "sets": [
        "labelNames"
      ]
    },
    "label": {
      "policy": "lww"
    },
    "note": {
      "policy": "fields",
      "text": [
        "text"
      ]
    },
    "readingPosition": {
      "policy": "lww"
    },
    "planProgress": {
      "policy": "fields",
      "sets": [
        "doneDays"
      ]
    },
    "readingPlan": {
      "policy": "lww"
    },
    "workspace": {
      "policy": "lww"
    },
    "setting": {
      "policy": "lww"
    },
    "project": {
      "policy": "fields",
      "opaque": [
        "notesRtf",
        "synthesisRtf"
      ]
    },
    "projectDoc": {
      "policy": "fields",
      "text": [
        "text"
      ]
    },
    "pericope": {
      "policy": "fields",
      "opaque": [
        "rtf"
      ]
    },
    "exegesis": {
